<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 1. TextView de título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_panel"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 2. TextView secundario con tu nombre completo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Emmanuel Alejo"
        android:textSize="16sp" />

    <!-- 3. LinearLayout contenedor con fondo suave y padding interno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#ECEFF1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEstadoModelo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estado_inicial"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 4. Button -->
    <Button
        android:id="@+id/btnSincronizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/texto_boton" />

</LinearLayout>